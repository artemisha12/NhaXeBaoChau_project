# ==============================================================
# NHAXEBAOCHAU - Environment Variables Template
# Sao chep file nay thanh .env.local roi dien gia tri that:
#   Windows: copy .env.example .env.local
#   Mac/Linux: cp .env.example .env.local
# ==============================================================

# --- Supabase ---
# Lay tu: Supabase Dashboard > Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_<your-anon-key>
SUPABASE_SERVICE_ROLE_KEY=<your-service-role-jwt>

# --- JWT Session (Admin) ---
# Tao bang lenh: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=<random-64-byte-hex-string>
